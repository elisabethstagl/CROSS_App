{
  "expo": {
    "name": "footprints",
    "slug": "footprints",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "footprints",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Footprints to take photos for your travel diary.",
        "NSLocationWhenInUseUsageDescription": "Allow Footprints to attach your current location to a Step."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151A17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Footprints to use your location.",
          "locationWhenInUsePermission": "Allow Footprints to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Footprints to take photos for your travel diary.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
